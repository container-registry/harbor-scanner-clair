{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "a80ecc00059d2a89dbff8ef5a940a2411893d0b1",
  "pull-request-header": "Adapter release. Merging tags `vX.Y.Z` and publishes the image and binaries.",
  "pull-request-footer": "Squash-merge to release. See [docs/RELEASES.md](https://github.com/container-registry/harbor-scanner-clair/blob/main/docs/RELEASES.md).",
  "pull-request-title-pattern": "chore: release adapter ${version}",
  "release-type": "go",
  "always-update": true,
  "include-v-in-tag": true,
  "exclude-paths": [
    ".github",
    "docs",
    "deploy",
    "taskfile",
    ".release-please"
  ],
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance Improvements"
    },
    {
      "type": "upstream",
      "section": "Upstream"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "refactor",
      "section": "Code Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI/CD",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build System",
      "hidden": true
    }
  ],
  "packages": {
    ".": {}
  }
}
