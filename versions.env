# Shared tool and base-image version pins - single source of truth.
# Loaded by Taskfile.yml via dotenv and consumed by CI workflows.
#
# dotenv exports every key here into the environment of every task, including
# `task test` and `task run`. The adapter reads SCANNER_* at runtime
# (pkg/etc/config.go), so no key here may use the SCANNER_ prefix or it will
# poison the unit tests and the local run.

# Lint and security tooling
# Must be built with a Go at least as new as the go directive in go.mod, or it
# cannot read the export data and reports one typecheck error instead of linting.
# renovate: datasource=github-releases depName=golangci/golangci-lint
GOLANGCILINT_VERSION=v2.13.2
# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.4.0
# Not Renovate-managed: the checksum pin below must be recomputed by hand.
TYPOS_VERSION=1.44.0
# crate-ci/typos publishes no checksums; this is our own pin of the
# x86_64-unknown-linux-musl release asset. Recompute when bumping TYPOS_VERSION:
#   curl -sfLO <release asset> && shasum -a 256 typos-*.tar.gz
TYPOS_SHA256_LINUX_X86_64=1b788b7d764e2f20fe089487428a3944ed218d1fb6fcd8eac4230b5893a38779
# renovate: datasource=pypi depName=yamllint
YAMLLINT_VERSION=1.35.1

# Task version installed by CI (local installs may differ)
# renovate: datasource=github-releases depName=go-task/task extractVersion=^v(?<version>.+)$
TASK_VERSION=3.49.1

# Alpine base image the adapter image is built FROM. Named for the image and not
# for the scanner, because CLAIR_VERSION below is the Clair backend version and
# the two must not be confused; SCANNER_* is reserved (see the header).
# The docker datasource, not github-releases, so a bump PR only appears once the
# tag the Dockerfile is FROM actually exists.
# renovate: datasource=docker depName=alpine
ALPINE_BASE_IMAGE_VERSION=3.24

# lprobe healthcheck binary (ghcr.io/fivexl/lprobe); same pin as harbor-next
# renovate: datasource=docker depName=ghcr.io/fivexl/lprobe
LPROBE_VERSION=0.1.9

# Clair backend, used ONLY by the component test compose. The example
# manifests under deploy/chart/example/ pin the same images literally and
# renovate.json has its own manager for them. Nothing here ships in the adapter
# image, and the adapter must never read this key: dotenv exports it into the
# environment of `task test` and `task run`.
# The image tag has no "v" prefix.
# renovate: datasource=docker depName=quay.io/projectquay/clair
CLAIR_VERSION=4.9.0
# PostgreSQL for the component-test Clair. 15 is what Clair's own local-dev
# compose pins; the uuid-ossp extension has to be available.
# renovate: datasource=docker depName=postgres
CLAIR_POSTGRES_VERSION=15

# Helm chart toolchain (chart-ci.yml installs the same pins)
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.2.3
# renovate: datasource=github-releases depName=helm-unittest/helm-unittest
HELM_UNITTEST_VERSION=v1.1.2
# renovate: datasource=github-releases depName=norwoodj/helm-docs extractVersion=^v(?<version>.+)$
HELM_DOCS_VERSION=1.14.2
# renovate: datasource=github-releases depName=helm/chart-testing extractVersion=^v(?<version>.+)$
CT_VERSION=3.14.0
# renovate: datasource=github-releases depName=stackrox/kube-linter extractVersion=^v(?<version>.+)$
KUBE_LINTER_VERSION=0.8.3
# renovate: datasource=github-releases depName=artifacthub/hub extractVersion=^v(?<version>.+)$
AH_VERSION=1.22.0
# renovate: datasource=github-releases depName=oras-project/oras extractVersion=^v(?<version>.+)$
ORAS_VERSION=1.3.3
# renovate: datasource=npm depName=ajv-cli
AJV_CLI_VERSION=5.0.0
# renovate: datasource=docker depName=node versioning=node
NODE_IMAGE_VERSION=22
# Python lint deps chart-testing shells out to
# renovate: datasource=pypi depName=yamale
YAMALE_VERSION=6.1.0
# renovate: datasource=pypi depName=pyyaml
PYYAML_VERSION=6.0.3
# Trivy, used ONLY as the chart misconfiguration scanner (config scan of the
# rendered manifests). Not a runtime dependency of this adapter.
# renovate: datasource=github-releases depName=aquasecurity/trivy extractVersion=^v(?<version>.+)$
TRIVY_CONFIG_SCANNER_VERSION=0.74.0
