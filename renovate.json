{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only the versions.env pins are Renovate-managed; dependabot keeps gomod and github-actions.",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pins in versions.env annotated with a `# renovate:` comment; an image pin may carry a _DIGEST line after its version",
      "fileMatch": ["^versions\\.env$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\n[A-Z0-9_]+=(?<currentValue>\\S+)(?:\\n[A-Z0-9_]+_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "The base image and healthprobe ship inside the adapter image, so a bump is an adapter patch release",
      "matchDepNames": ["alpine", "8gears.container-registry.com/healthprobe/healthprobe"],
      "semanticCommits": "enabled",
      "semanticCommitType": "fix"
    },
    {
      "description": "Tooling pins never reach the image; keep them out of the changelog",
      "matchDepNames": [
        "golangci/golangci-lint",
        "golang.org/x/vuln",
        "go-task/task",
        "yamllint",
        "helm/helm",
        "helm-unittest/helm-unittest",
        "norwoodj/helm-docs",
        "helm/chart-testing",
        "stackrox/kube-linter",
        "artifacthub/hub",
        "oras-project/oras",
        "ajv-cli",
        "node",
        "yamale",
        "pyyaml",
        "aquasecurity/trivy"
      ],
      "semanticCommits": "enabled",
      "semanticCommitType": "ci"
    }
  ]
}
